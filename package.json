{
  "name": "hhlblog-global",
  "type": "module",
  "version": "0.1.0",
  "description": "A fast, content-first blog built with Astro 5, Svelte 5 and Tailwind CSS, with a fully static English-only output.",
  "license": "MIT",
  "author": "HHLBlog contributors",
  "homepage": "https://www.hehonglei.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HONGLEI111/hhlblog-global.git"
  },
  "bugs": {
    "url": "https://github.com/HONGLEI111/hhlblog-global/issues"
  },
  "keywords": [
    "astro",
    "svelte",
    "tailwindcss",
    "blog",
    "static-site",
    "pagefind"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check:responsive": "node scripts/responsive-check.mjs",
    "check:nav": "node scripts/nav-check.mjs",
    "check:chat": "node scripts/chat-check.mjs",
    "check:optimizations": "node scripts/verify-optimizations.mjs",
    "astro": "astro",
    "type-check": "tsc --noEmit --isolatedDeclarations",
    "test": "vitest run",
    "new-post": "node scripts/new-post.js",
    "new-technology": "node scripts/new-technology.js",
    "new-read": "node scripts/new-read.js",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "clean": "node -e \"for (const p of ['dist','.astro','.tmp-cache','.tmp-data']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/svelte": "7.2.5",
    "@astrojs/tailwind": "^6.0.2",
    "@expressive-code/core": "^0.41.4",
    "@expressive-code/plugin-collapsible-sections": "^0.41.4",
    "@expressive-code/plugin-line-numbers": "^0.41.4",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/roboto": "^5.2.9",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.50",
    "@iconify-json/tabler": "^1.2.33",
    "@swup/astro": "^1.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "5.13.10",
    "astro-expressive-code": "^0.41.4",
    "astro-icon": "^1.1.5",
    "beautiful-mermaid": "^1.1.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hastscript": "^9.0.1",
    "katex": "^0.16.27",
    "markdown-it": "^14.1.0",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.12.0",
    "pagefind": "^1.4.0",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-github-admonitions-to-directives": "^1.0.5",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "stylus": "^0.64.0",
    "svelte": "^5.39.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/ts-plugin": "^1.10.6",
    "@biomejs/biome": "2.5.9",
    "@types/hast": "^3.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.0",
    "playwright": "^1.59.1",
    "postcss-import": "^16.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.14.4"
}
