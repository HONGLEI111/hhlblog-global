---
import "@fontsource/roboto/latin-400.css";
import "@fontsource/roboto/latin-500.css";
import "@fontsource/roboto/latin-700.css";
// The font files themselves, so they can be preloaded: the @font-face rules sit
// in the inlined CSS, so the browser only discovers the fonts *after* it has
// parsed that CSS — a late, very-high-priority font request that delays the
// first paint and competes with the LCP image.
import robotoLatin400 from "@fontsource/roboto/files/roboto-latin-400-normal.woff2?url";
import robotoLatin500 from "@fontsource/roboto/files/roboto-latin-500-normal.woff2?url";
import robotoLatin700 from "@fontsource/roboto/files/roboto-latin-700-normal.woff2?url";

import { profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import "../styles/variables.styl";
import "../styles/markdown.css";
import "../styles/markdown-extend.styl";
import "../styles/scrollbar.css";
import "../styles/transition.css";
import "../styles/expressive-code.css";
import "../styles/legacy-fallback.css";
import ChatWidget from "@components/features/ChatWidget.svelte";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	canonical?: string;
	ogImage?: string;
	excerpt?: string;
}

let {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	canonical,
	ogImage,
	excerpt,
} = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const metaDescription = (description || excerpt || pageTitle).trim();
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ?? new URL("/og-image.jpg", Astro.site).href;

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] text-[var(--deep-text)] transition text-[14px] md:text-[16px]"
	  data-overlayscrollbars-initialize
>
	<head>


		<!-- Prevent CSS transition flash on initial page load -->
		<style id="prevent-flash">
			html, body {
				transition: none !important;
			}
		</style>
		<!-- Without JS the scroll-reveal elements would stay opacity-0; force them visible. -->
		<noscript>
			<style>
				@media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
					.intersect-once, .intersect-quarter, .intersect-no-queue { opacity: 1 !important; }
				}
			</style>
		</noscript>
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonicalUrl} />

		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription}>
		<meta name="author" content={profileConfig.name}>

		<!-- 百度站长平台站点验证（仅首页输出） -->
		{isHomePage && <meta name="baidu-site-verification" content="codeva-mfTB8hvjqT" />}

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:locale" content={siteLang}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={metaDescription}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={metaDescription}>

		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png">
		<link rel="preload" as="font" type="font/woff2" crossorigin href={robotoLatin400} />
		<link rel="preload" as="font" type="font/woff2" crossorigin href={robotoLatin500} />
		<link rel="preload" as="font" type="font/woff2" crossorigin href={robotoLatin700} />
		<link rel="manifest" href="/manifest.webmanifest">
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f6fb">
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#232130">
		<meta property="og:image" content={ogImageUrl}>
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta name="twitter:image" content={ogImageUrl}>

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<slot />
		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	<ChatWidget client:idle></ChatWidget>

	<!-- PWA: register the service worker for offline caching of static assets -->
	{import.meta.env.PROD && <script is:inline>
		if ("serviceWorker" in navigator) {
			window.addEventListener("load", () => {
				navigator.serviceWorker.register("/sw.js").catch(() => {});
			});
		}
	</script>}
</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}

	/* Home page (desktop lg+): taller banner. The body carries the literal class
	   `lg:is-home`, so these rules are gated to the lg breakpoint to match the
	   `window.innerWidth >= 1024` check in the scroll handler. */
	@media (min-width: 1024px) {
		.enable-banner.lg\:is-home #banner-wrapper {
			@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
		}
		.enable-banner.lg\:is-home #banner {
			@apply h-[var(--banner-height-home)] translate-y-0
		}
		.enable-banner.lg\:is-home #main-grid {
			@apply translate-y-[var(--banner-height-extend)];
		}
		.enable-banner.lg\:is-home #sidebar-sticky {
			@apply top-[calc(1rem_-_var(--banner-height-extend))]
		}
	}

	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}
</style>

<script>
import 'overlayscrollbars/overlayscrollbars.css';
// OverlayScrollbars is a progressive enhancement (custom scrollbars). Load its JS
// lazily so it doesn't bloat the initial bundle.
let overlayscrollbarsPromise: Promise<any> | null = null;
async function getOverlayScrollbars(): Promise<any> {
	if (!overlayscrollbarsPromise) {
		overlayscrollbarsPromise = import('overlayscrollbars');
	}
	return overlayscrollbarsPromise;
}
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";
import {pathsEqual, url} from "../utils/url-utils";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT
} from "../constants/constants";
import { siteConfig } from '../config';

const bannerEnabled = !!document.getElementById('banner-wrapper')

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom!.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

async function initCustomScrollbar() {
	const bodyElement = document.querySelector('body');
	if (!bodyElement) return;
	const { OverlayScrollbars } = await getOverlayScrollbars();
	OverlayScrollbars(
		// docs say that a initialization to the body element would affect native functionality like window.scrollTo
		// but just leave it here for now
		{
			target: bodyElement,
			cancel: {
				nativeScrollbarsOverlaid: true,    // don't initialize the overlay scrollbar if there is a native one
			}
		}, {
		scrollbars: {
			theme: 'scrollbar-base scrollbar-auto py-1',
			autoHide: 'move',
			autoHideDelay: 500,
			autoHideSuspend: false,
		},
	});

	const katexElements = document.querySelectorAll('.katex-display') as NodeListOf<HTMLElement>;

	const katexObserverOptions = {
		root: null,
		rootMargin: '100px',
		threshold: 0.1
	};

	const processKatexElement = (element: HTMLElement) => {
		if (!element.parentNode) return;
		if (element.hasAttribute('data-scrollbar-initialized')) return;

		const container = document.createElement('div');
		container.className = 'katex-display-container';
		container.setAttribute('aria-label', 'scrollable container for formulas');

		element.parentNode.insertBefore(container, element);
		container.appendChild(element);

		OverlayScrollbars(container, {
			scrollbars: {
				theme: 'scrollbar-base scrollbar-auto',
				autoHide: 'leave',
				autoHideDelay: 500,
				autoHideSuspend: false
			}
		});

		element.setAttribute('data-scrollbar-initialized', 'true');
	};

	const katexObserver = new IntersectionObserver((entries, observer) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
			processKatexElement(entry.target as HTMLElement);
			observer.unobserve(entry.target);
			}
		});
	}, katexObserverOptions);

	katexElements.forEach(element => {
		katexObserver.observe(element);
	});
}

function showBanner() {
	if (!siteConfig.banner.enable) return;

	const banner = document.getElementById('banner');
	if (!banner) {
		console.error('Banner element not found');
		return;
	}

	banner.classList.remove('opacity-0', 'scale-105');
}

function init() {
	loadTheme();
	loadHue();
	showBanner();
}

/* OverlayScrollbars init is expensive (scrollbar host + observers on the whole body).
   Defer it off the critical path so it does not delay first paint / LCP. */
function idleInitScrollbar() {
	initCustomScrollbar();
}
if (typeof window.requestIdleCallback === "function") {
	window.requestIdleCallback(idleInitScrollbar, { timeout: 2000 });
} else {
	setTimeout(idleInitScrollbar, 300);
}

/* Load settings when entering the site */
init();

/* Remove flash-prevention style after first paint to re-enable smooth theme transitions */
function removePreventFlash() {
	requestAnimationFrame(() => {
		requestAnimationFrame(() => {
			const preventFlash = document.getElementById('prevent-flash');
			if (preventFlash) preventFlash.remove();
		});
	});
}
removePreventFlash();

/* Insert flash-prevention style for Swup page transitions */
function addPreventFlash() {
	if (document.getElementById('prevent-flash')) return;
	const style = document.createElement('style');
	style.id = 'prevent-flash';
	style.textContent = 'html, body { transition: none !important; }';
	document.head.prepend(style);
}

const setup = () => {
	// TODO: temp solution to change the height of the banner
/*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
	window.swup.hooks.on('link:click', () => {
		// NOTE: `--content-delay` used to be rewritten to 0ms here. Changing an animation-delay
		// restarts the animation, so that replayed the outgoing page's entrance animations (every
		// card jumped back to opacity 0 on click) — a visible flash right before the swap.
		// Swapped-in content no longer animates at all (`html.swup-nav` in transition.css), so the
		// delay does not need adjusting either.

		// prevent elements from overlapping the navbar
		if (!bannerEnabled) {
			return
		}
		let threshold = window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16
		let navbar = document.getElementById('navbar-wrapper')
		if (!navbar || !document.body.classList.contains('lg:is-home')) {
			return
		}
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		}
	})
	window.swup.hooks.on('content:replace', initCustomScrollbar)
	window.swup.hooks.on('content:replace', (visit: {to: {url: string}}) => {
		// Swup only swaps the innerHTML of the containers (`main`, `#toc`, `#sidebar`);
		// it does not sync their classes. Sync the grid/sidebar layout here — after the content
		// has been swapped and while the outgoing content is still faded out — instead of in
		// `visit:start`, where the `display` change would jump before the fade-out even begins.
		const isHome = pathsEqual(visit.to.url, url('/'))

		// update #main-grid layout classes for the target page
		const mainGrid = document.getElementById('main-grid')
		if (mainGrid) {
			const gridClasses = ['grid', 'grid-cols-[17.5rem_auto]', 'grid-rows-[auto_1fr_auto]', 'lg:grid-rows-[auto]', 'gap-4', 'px-0', 'md:px-4']
			if (isHome) {
				mainGrid.classList.remove(...gridClasses)
			} else {
				mainGrid.classList.add(...gridClasses)
			}
		}

		// show/hide the sidebar (Profile + categories + tags) for the target page.
		// The grid placement classes live on the `#sidebar` element itself, which Swup
		// does not swap, so they must be synced together with the `hidden` state.
		const sidebar = document.getElementById('sidebar')
		if (sidebar) {
			const sidebarClasses = [
				'mb-4', 'row-start-2', 'row-end-3', 'col-span-2',
				'lg:row-start-1', 'lg:row-end-2', 'lg:col-span-1', 'lg:max-w-[17.5rem]',
			]
			if (isHome) {
				sidebar.classList.add('hidden')
				sidebar.classList.remove(...sidebarClasses)
			} else {
				sidebar.classList.remove('hidden')
				sidebar.classList.add(...sidebarClasses)
			}
		}

		// sync the grid column classes of `main` and the footer, which also differ
		// between the home (full-width) and non-home (grid) layouts
		const swupContainer = document.getElementById('swup-container')
		if (swupContainer) {
			if (isHome) {
				swupContainer.classList.remove('col-span-2', 'lg:col-span-1')
			} else {
				swupContainer.classList.add('col-span-2', 'lg:col-span-1')
			}
		}

		const footer = document.querySelector('#main-grid .footer')
		if (footer) {
			if (isHome) {
				footer.classList.remove('col-span-2', 'block')
			} else {
				footer.classList.add('col-span-2', 'block')
			}
		}
	})
	window.swup.hooks.on('visit:start', (visit: {to: {url: string}}) => {
		// Prevent flash during page transition
		addPreventFlash();

		// From now on the document is navigated in place: anything the swap inserts must not
		// replay the first-paint entrance animations (see `html.swup-nav` in transition.css).
		document.documentElement.classList.add('swup-nav');

		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		const isHome = pathsEqual(visit.to.url, url('/'))
		if (isHome) {
			bodyElement!.classList.add('lg:is-home');
		} else {
			bodyElement!.classList.remove('lg:is-home');
		}

		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}
	});
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		// Re-enable transitions after page transition completes
		removePreventFlash();

		setTimeout(() => {
			// The page-height extend is only needed while the transition (and its smooth scroll)
			// is in flight; `visit:start` re-adds it on the way in.
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.add('hidden')
			}

            // Just make the transition looks better
            const toc = document.getElementById('toc-wrapper');
            if (toc) {
                toc.classList.remove('toc-not-ready')
            }
        }, 200)
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

// ── Consolidated scroll handling ──
// One rAF-throttled handler replaces the two previous scroll listeners
// (Layout's `onscroll` + Navbar's `initBannerTransparency`). DOM refs are
// cached and classes are only written when their state actually changes.
const backToTopBtn = document.getElementById('back-to-top-btn');
const toc = document.getElementById('toc-wrapper');
const navbarWrapper = document.getElementById('navbar-wrapper');
const navbarEl = document.getElementById('navbar');

const NAVBAR_HEIGHT = 72;
const NAVBAR_SCROLLED_THRESHOLD = 50;

const scrollState = {
	backToTop: false,
	toc: false,
	navbarHidden: false,
	navbarScrolled: false,
};

function setScrollClass(
	el: HTMLElement | null,
	cls: string,
	on: boolean,
	stateKey: keyof typeof scrollState,
) {
	if (!el) return;
	if (scrollState[stateKey] === on) return; // no change, skip the DOM write
	scrollState[stateKey] = on;
	el.classList.toggle(cls, on);
}

function updateOnScroll() {
	const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
	const bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100);

	// Back-to-top + TOC visibility (below the banner).
	setScrollClass(backToTopBtn, 'hide', scrollTop <= bannerHeight, 'backToTop');
	if (bannerEnabled) {
		setScrollClass(toc, 'toc-hide', scrollTop <= bannerHeight, 'toc');
	}

	// Navbar transparency over the banner (subtle scroll).
	if (navbarEl && navbarEl.getAttribute('data-enable-banner') === 'true') {
		setScrollClass(navbarEl, 'navbar-scrolled', scrollTop > NAVBAR_SCROLLED_THRESHOLD, 'navbarScrolled');
	}

	// Navbar hide when scrolling deep into the banner.
	if (bannerEnabled && navbarWrapper) {
		const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16; // The height the main panel overlaps the banner
		let targetBannerHeight = BANNER_HEIGHT;
		if (document.body.classList.contains('lg:is-home') && window.innerWidth >= 1024) {
			targetBannerHeight = BANNER_HEIGHT_HOME;
		}
		const threshold = window.innerHeight * (targetBannerHeight / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16;
		setScrollClass(navbarWrapper, 'navbar-hidden', scrollTop >= threshold, 'navbarHidden');
	}
}

let scrollTicking = false;
function onScroll() {
	if (scrollTicking) return;
	scrollTicking = true;
	requestAnimationFrame(() => {
		updateOnScroll();
		scrollTicking = false;
	});
}
window.addEventListener('scroll', onScroll, { passive: true });
updateOnScroll();

window.onresize = () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}

</script>

<script>
import type PhotoSwipeLightbox from "photoswipe/lightbox"

// PhotoSwipe is only needed when the user opens an image; load it lazily.
// The type-only import above is erased at build time, so nothing is bundled.
// Note: import() must be called inside the function — a module-level import()
// would start fetching immediately when the script is evaluated.
let lightbox: PhotoSwipeLightbox | undefined
let lightboxPromise: Promise<PhotoSwipeLightbox> | null = null

async function ensurePhotoSwipe(): Promise<PhotoSwipeLightbox> {
	if (lightbox) return lightbox;
	if (!lightboxPromise) {
		lightboxPromise = (async () => {
			await import("photoswipe/style.css");
			await import("../styles/photoswipe.css");
			const pswpPromise = import("photoswipe");
			const { default: PhotoSwipeLightbox } = await import("photoswipe/lightbox");
			await pswpPromise;
			lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswpPromise,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
	return lightbox
		})()
	}
	return lightboxPromise
}

// Lazy open: PhotoSwipe is only loaded the first time the user clicks an
// article image. After that the lightbox behaves exactly as before.
document.addEventListener("click", async (event) => {
	const img = (event.target as Element | null)?.closest?.(".custom-md img, #post-cover img");
	if (!(img instanceof HTMLImageElement)) return;
	event.preventDefault();
	event.stopPropagation();
	const box = await ensurePhotoSwipe();
	const gallery = Array.from(document.querySelectorAll<HTMLImageElement>(".custom-md img, #post-cover img"));
	const index = Math.max(0, gallery.indexOf(img));
	// Pass the DOM elements themselves; the domItemData filter above maps them
	// to src/msrc/dimensions exactly as the old click-through behavior did.
	box.loadAndOpen(index, { gallery: img, items: gallery });
});

const setup = () => {
	// Recreate the lightbox after each Swup page transition, since the
	// previous DOM gallery no longer exists.
	window.swup.hooks.on(
		"content:replace",
		() => {
			if (lightbox) {
				lightbox.destroy();
				lightbox = undefined;
				lightboxPromise = null;
			}
		},
		{ before: true },
	)
}

if (window.swup) {
	setup()
} else {
	document.addEventListener("swup:enable", setup)
}
</script>

<script>
// Scroll-reveal: elements marked with `intersect-*` classes are hidden by
// `motion-safe:md:opacity-0` and revealed by `intersect:animate-fade` (the
// `intersect` variant targets `[data-intersected]`). Drive that reveal with an
// IntersectionObserver so widgets fade in as they enter the viewport instead of
// all animating at once on every page load / Swup navigation.
let intersectObserver: IntersectionObserver | null = null;

function initIntersectReveal() {
	const elements = document.querySelectorAll<HTMLElement>(
		'.intersect-once, .intersect-quarter, .intersect-no-queue',
	);

	intersectObserver?.disconnect();

	if (elements.length === 0) return;

	// Fallback: reveal everything if IntersectionObserver is unavailable, so
	// content never stays permanently hidden.
	if (!('IntersectionObserver' in window)) {
		elements.forEach((el) => el.setAttribute('data-intersected', ''));
		return;
	}

	intersectObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				const el = entry.target as HTMLElement;
				const once = el.classList.contains('intersect-once');
				if (entry.isIntersecting) {
					el.setAttribute('data-intersected', '');
					if (once) intersectObserver!.unobserve(el);
				} else if (!once) {
					el.removeAttribute('data-intersected');
				}
			});
		},
		{ threshold: 0, rootMargin: '0px 0px -10% 0px' },
	);

	elements.forEach((el) => intersectObserver!.observe(el));
}

initIntersectReveal();

const setupIntersectReveal = () => {
	window.swup.hooks.on('content:replace', initIntersectReveal);
};
if (window.swup) {
	setupIntersectReveal();
} else {
	document.addEventListener('swup:enable', setupIntersectReveal);
}
</script>
