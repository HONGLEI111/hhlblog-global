---
import type { GetStaticPaths } from "astro";
import BlogPage from "../../components/blog/BlogPage.astro";
import Pagination from "../../components/controls/Pagination.astro";
import { PAGE_SIZE } from "../../constants/constants";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogBlog = await getSortedPosts();
	return paginate(allBlogBlog, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const len = page.data.length;
const isFirstPage = page.currentPage === 1;
const listingTitle = isFirstPage ? "博客" : `博客 - 第 ${page.currentPage} 页`;
const listingDescription = "技术学习、前端开发经验与日常思考的博客文章列表。";
const canonical = isFirstPage
	? undefined
	: new URL(page.url.first ?? "/posts/", Astro.site).href;
const prevHref = page.url.prev
	? new URL(page.url.prev, Astro.site).href
	: undefined;
const nextHref = page.url.next
	? new URL(page.url.next, Astro.site).href
	: undefined;
---

<MainGridLayout title={listingTitle} description={listingDescription} canonical={canonical} sidebarCollection="posts">
    {prevHref && <link slot="head" rel="prev" href={prevHref} />}
    {nextHref && <link slot="head" rel="next" href={nextHref} />}
    <BlogPage page={page} collection="posts"></BlogPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
