---
import type { GetStaticPaths } from "astro";
import BlogPage from "../../components/blog/BlogPage.astro";
import Pagination from "../../components/controls/Pagination.astro";
import { PAGE_SIZE } from "../../constants/constants";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedTechnology } from "../../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedTechnology();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
const isFirstPage = page.currentPage === 1;
const listingTitle = isFirstPage ? "技术" : `技术 - 第 ${page.currentPage} 页`;
const listingDescription = "数据结构与算法、前端基础等技术文章列表。";
const canonical = isFirstPage
	? undefined
	: new URL(page.url.first ?? "/technology/", Astro.site).href;
const prevHref = page.url.prev
	? new URL(page.url.prev, Astro.site).href
	: undefined;
const nextHref = page.url.next
	? new URL(page.url.next, Astro.site).href
	: undefined;
---

<MainGridLayout title={listingTitle} description={listingDescription} canonical={canonical} sidebarCollection="technology">
    {prevHref && <link slot="head" rel="prev" href={prevHref} />}
    {nextHref && <link slot="head" rel="next" href={nextHref} />}
    <BlogPage page={page} collection="technology"></BlogPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
