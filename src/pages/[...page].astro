---
import type { GetStaticPaths } from "astro";
import AboutMe from "~/components/landing/AboutMe.astro";
import BlogLatestPosts from "~/components/landing/BlogLatestPosts.astro";
import MovingTechStack from "~/components/landing/MovingTechStack.astro";
import Projects from "~/components/landing/Projects.astro";
import TechStack from "~/components/landing/TechStack.astro";
import Pagination from "../components/controls/Pagination.astro";
import PostPage from "../components/layout/PostPage.astro";
import { profileConfig, siteConfig } from "../config";
import { PAGE_SIZE } from "../constants/constants";
import HomeLayout from "../layouts/HomeLayout.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const len = page.data.length;
const isHomePage = page.currentPage === 1;

const listTitle = isHomePage ? undefined : `Page ${page.currentPage}`;
const listCanonical = isHomePage ? undefined : new URL("/", Astro.site).href;

const websiteJsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: siteConfig.title,
	url: new URL("/", Astro.site).href,
	description: siteConfig.subtitle,
	inLanguage: siteConfig.lang.replace("_", "-"),
};

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: profileConfig.name,
	url: new URL("/", Astro.site).href,
	sameAs: profileConfig.links
		.map((l) => l.url)
		.filter((u) => u.startsWith("http")),
};
---

{
  isHomePage ? (
    <HomeLayout>
      <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)}></script>
      <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
      <!-- Project introduction -->
      <AboutMe
        avatar={profileConfig.avatar ?? "/favicon/logo.png"}
        name={profileConfig.name}
        role="Open-source blog theme"
        bio="A fast, content-first blog built with Astro 5, Svelte 5 and Tailwind CSS. Static output, Pagefind search, dark mode, and Markdown extras such as KaTeX and Mermaid."
        tags={["Astro 5", "Svelte 5", "TypeScript", "Tailwind CSS"]}
        socialLinks={profileConfig.links}
      />

      <!-- Blog Tech Stack -->
      <TechStack
        title="Built With"
        subtitle="The stack this site is built on — chosen for performance and a good authoring experience"
        columns={4}
        items={[
          { icon: 'tabler:rocket', name: 'Astro 5', description: 'Modern static site generator' },
          { icon: 'tabler:brand-tailwind', name: 'Tailwind CSS 3', description: 'Utility-first CSS framework' },
          { icon: 'tabler:braces', name: 'TypeScript', description: 'Type-safe JavaScript' },
          { icon: 'tabler:arrows-left-right', name: 'Swup', description: 'Page transition animations' },
        ]}
      />

      <!-- Latest Blog Posts -->
      <BlogLatestPosts
        title="Latest Posts"
        information="Writing on software engineering, frontend development and the occasional detour."
      />

      <!-- My Tech Skills -->
      <MovingTechStack
        title="Toolbox"
        subtitle="Languages, frameworks and tools I reach for most often"
        items={[
          { icon: 'fa6-brands:react', name: 'React' },
          { icon: 'fa6-brands:vuejs', name: 'Vue.js' },
          { icon: 'tabler:braces', name: 'TypeScript' },
          { icon: 'fa6-brands:js', name: 'JavaScript' },
          { icon: 'fa6-brands:html5', name: 'HTML5' },
          { icon: 'fa6-brands:css3-alt', name: 'CSS3' },
          { icon: 'tabler:brand-tailwind', name: 'Tailwind CSS' },
          { icon: 'tabler:rocket', name: 'Astro' },
          { icon: 'tabler:stack', name: 'Svelte' },
          { icon: 'fa6-brands:node-js', name: 'Node.js' },
          { icon: 'tabler:git-branch', name: 'Git' },
          { icon: 'tabler:code', name: 'VS Code' },
          { icon: 'tabler:package', name: 'pnpm' },
          { icon: 'tabler:bolt', name: 'Vite' },
          { icon: 'tabler:file-text', name: 'Markdown' },
        ]}
      />

      <!-- Open source -->
      <Projects
        title="Open Source"
        subtitle="Where this project lives"
        items={[
          {
            name: 'HHLBlog',
            description: 'This site: an Astro 5 + Svelte 5 blog theme with a fully static build, Pagefind search, dark mode and Markdown extras. The code is MIT licensed.',
            tech: ['Astro', 'Svelte', 'TypeScript', 'Tailwind CSS'],
            link: 'https://www.hehonglei.com',
            github: 'https://github.com/HONGLEI111/hhlblog-global',
            icon: 'tabler:world',
          },
        ]}
      />
    </HomeLayout>
  ) : (
    <MainGridLayout title={listTitle} canonical={listCanonical}>
      <PostPage page={page}></PostPage>
      <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
    </MainGridLayout>
  )
}
