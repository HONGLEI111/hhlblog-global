---
import { Image as AstroImage } from "astro:assets";
import path from "node:path";
import fallbackCover1 from "~/assets/fallback-covers/fallback-cover-1.avif";
import fallbackCover2 from "~/assets/fallback-covers/fallback-cover-2.avif";
import fallbackCover3 from "~/assets/fallback-covers/fallback-cover-3.avif";
import fallbackCover4 from "~/assets/fallback-covers/fallback-cover-4.avif";
import ImageWrapper from "~/components/misc/ImageWrapper.astro";
import type { Post } from "~/types";
import { getDir } from "~/utils/url-utils";
import { getFormattedDate } from "~/utils/utils";

const fallbackCovers = [
	fallbackCover1,
	fallbackCover2,
	fallbackCover3,
	fallbackCover4,
];

export interface Props {
	posts?: Post[];
}

const visibleCount = 4;

/*
 * Card width is 276px in the 4-column desktop grid; 2x DPR therefore wants ~552
 * device pixels. The old [400, 768] list had no candidate between them, so the
 * browser always picked 400w and upscaled it — that, not the `quality` setting,
 * was what made these covers look soft.
 */
const coverWidths = [400, 560, 800, 1120];
const coverSizes = "(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 276px";
---

{
  Astro.props.posts && Astro.props.posts.length > 0 && (
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {Astro.props.posts.map((post, index) => (
        <a href={post.permalink} class="group intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <div class="relative aspect-[2/1] mb-4 rounded-md overflow-hidden bg-gray-200">
            {typeof post.image === 'string' && post.image ? (
              <ImageWrapper
                src={post.image}
                basePath={path.join("content/posts/", getDir(post.id))}
                alt={post.title || ''}
                class="w-full h-full group-hover:scale-105 transition-transform duration-300"
                widths={coverWidths}
                sizes={coverSizes}
                loading="lazy"
              />
            ) : (
              <AstroImage
                src={fallbackCovers[index % fallbackCovers.length]}
                alt={post.title || ''}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                widths={coverWidths}
                sizes={coverSizes}
                format="webp"
                quality={72}
                loading="lazy"
              />
            )}
          </div>
          <div class="text-xs text-muted mb-1">
            {post.publishDate && <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>}
          </div>
          <h3 class="font-semibold text-lg group-hover:text-primary transition-colors">{post.title}</h3>
          {post.excerpt && <p class="mt-2 text-sm text-muted line-clamp-2">{post.excerpt}</p>}
        </a>
      ))}
    </div>
  )
}
